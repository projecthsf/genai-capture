<!-- Loaded only when com.intellij.mcpServer is present (optional dependency,
     bundled in IDEs 2025.2+). Registers GenAI Capture's MCP tools with the IDE's
     built-in MCP server. On older IDEs this file is ignored and the plugin's
     capture/menu features work as before. -->
<idea-plugin>
    <extensions defaultExtensionNs="com.intellij.mcpServer">
        <mcpToolset implementation="io.genai.screenshot.mcpide.CaptureIdeToolset"/>
    </extensions>
</idea-plugin>
